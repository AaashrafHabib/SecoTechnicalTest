{
  "family": "building-intelligence",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "building-intelligence",
      "image": "ACCOUNT_ID.dkr.ecr.eu-west-1.amazonaws.com/building-intelligence:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "SECO_AWS_REGION", "value": "eu-west-1"},
        {"name": "SECO_BEDROCK_MODEL_ID", "value": "anthropic.claude-3-sonnet-20240229-v1:0"},
        {"name": "SECO_BEDROCK_EMBEDDINGS_MODEL_ID", "value": "amazon.titan-embed-text-v2:0"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/building-intelligence",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "essential": true
    }
  ]
}
